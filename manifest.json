{
  "manifest_version": 3,
  "name": "QuickJump – Return instantly to important tab from any app or screen",
  "version": "0.3.4",
  "description": "Pin tabs to an always-on-top floating bar and jump back to them with one click.",
  "author": "enloop.md",
  "homepage_url": "https://ryabenko-pro.github.io/quickjump/",
  "minimum_chrome_version": "116",
  "permissions": ["alarms", "contextMenus", "storage", "tabs"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "QuickJump"
  },
  "options_ui": {
    "page": "settings/settings.html",
    "open_in_tab": false
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
